---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const categories = ['ai-tech', 'bisnes', 'isu-semasa', 'sains', 'islam', 'sejarah', 'minda'];

export async function getStaticPaths() {
  const categories = ['ai-tech', 'bisnes', 'isu-semasa', 'sains', 'islam', 'sejarah', 'minda'];
  const allPosts = await getCollection('posts');

  return categories.map((cat) => ({
    params: { cat },
    props: {
      category: cat,
      posts: allPosts
        .filter((post) => !post.data.draft && post.data.category === cat)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category} — Syrimo`}>
  <Header />

  <main class="max-w-4xl mx-auto px-6">
    <section class="py-12">
      <a href="/" class="text-sm text-gray-500 dark:text-gray-400 hover:underline">&larr; All posts</a>
      <h1 class="mt-4 text-4xl font-bold tracking-tight capitalize">{category}</h1>
    </section>

    <!-- Category Pills -->
    <section class="flex flex-wrap gap-2 pb-8">
      {categories.map((cat) => (
        <a
          href={`/category/${cat}`}
          class:list={[
            'px-3 py-1 text-sm rounded-full border transition-colors',
            cat === category
              ? 'bg-gray-900 text-white border-gray-900 dark:bg-white dark:text-black dark:border-white'
              : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800',
          ]}
        >
          {cat}
        </a>
      ))}
    </section>

    <!-- Posts -->
    <section class="flex flex-col gap-8 pb-16">
      {posts.length > 0 ? (
        posts.map((post) => (
          <PostCard post={post} />
        ))
      ) : (
        <p class="text-gray-500 dark:text-gray-400">No posts in this category yet.</p>
      )}
    </section>
  </main>

  <Footer />
</BaseLayout>
