---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import TakeawayBox from '../components/TakeawayBox.astro';

interface Props {
  title: string;
  category: string;
  date: Date;
  description: string;
  image?: string;
  takeaways?: string[];
  tags?: string[];
}

const { title, category, date, description, image, takeaways, tags } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — SYRIMO`} description={description} ogImage={image}>
  <Header />

  <main class="max-w-2xl mx-auto px-6 pt-28 pb-16">
    <!-- Post header -->
    <div class="mb-10">
      <CategoryBadge category={category} />
      <h1 class="text-3xl sm:text-4xl font-bold mt-4 mb-4 leading-tight font-[var(--font-serif)]">
        {title}
      </h1>
      <div class="flex items-center gap-3 text-sm text-[var(--color-text-muted)]">
        <span>{formattedDate}</span>
        <span class="text-[var(--color-border)]">&middot;</span>
        <span>Syah</span>
      </div>
    </div>

    <!-- Hero image -->
    {image && (
      <div class="mb-10 -mx-6 sm:mx-0">
        <img src={image} alt={title} class="w-full rounded-none sm:rounded-xl" loading="eager" />
      </div>
    )}

    <!-- Post content -->
    <article class="prose prose-invert max-w-none
      prose-headings:font-[var(--font-serif)] prose-headings:text-[var(--color-text-primary)]
      prose-p:text-[var(--color-text-secondary)] prose-p:leading-relaxed
      prose-a:text-[var(--color-accent)] prose-a:no-underline hover:prose-a:underline
      prose-strong:text-[var(--color-text-primary)]
      prose-code:text-[var(--color-accent)] prose-code:font-[var(--font-mono)]
      prose-blockquote:border-[var(--color-accent)] prose-blockquote:text-[var(--color-text-secondary)]
      prose-li:text-[var(--color-text-secondary)]
    ">
      <slot />
    </article>

    <!-- Takeaways rendered inline within post content -->

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-2">
        {tags.map((tag: string) => (
          <span class="text-xs px-3 py-1 rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-text-secondary)] transition-colors">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Share -->
    <div class="mt-14 pt-8 border-t border-[var(--color-border)]">
      <p class="text-xs uppercase tracking-widest text-[var(--color-text-muted)] mb-4">Share this post</p>
      <div class="flex items-center gap-3">
        <a
          id="share-fb"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-muted)] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          Facebook
        </a>
        <a
          id="share-x"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-muted)] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a
          id="share-linkedin"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-muted)] transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
        <button
          id="share-copy"
          class="flex items-center gap-2 px-4 py-2 text-sm rounded-lg border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-text-muted)] transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span id="copy-text">Copy link</span>
        </button>
      </div>
    </div>

    <!-- Back link -->
    <div class="mt-8">
      <a
        href="/"
        class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-accent)] transition-colors"
      >
        &larr; Back to all posts
      </a>
    </div>
  </main>

  <Footer />

  <script is:inline>
    (function() {
      const url = encodeURIComponent(window.location.href);
      const title = encodeURIComponent(document.title);
      document.getElementById('share-fb').href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
      document.getElementById('share-x').href = `https://x.com/intent/tweet?url=${url}&text=${title}`;
      document.getElementById('share-linkedin').href = `https://www.linkedin.com/sharing/share-offsite/?url=${url}`;
      document.getElementById('share-copy').addEventListener('click', function() {
        navigator.clipboard.writeText(window.location.href).then(function() {
          document.getElementById('copy-text').textContent = 'Copied!';
          setTimeout(function() { document.getElementById('copy-text').textContent = 'Copy link'; }, 2000);
        });
      });
    })();
  </script>
</BaseLayout>
